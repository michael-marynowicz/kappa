# ============================================================
# Sprint Reporter - Local dev environment variables
# ============================================================
# USAGE:
#   1. Copy this file to .env  (gitignored — ne jamais committer)
#   2. Remplir les valeurs réelles ci-dessous
#   3. Charger dans IntelliJ : Run > Edit Configurations > EnvFile (plugin)
#      OU coller les valeurs dans "Environment Variables" de la run config
#
# SOURCES des valeurs :
#   MAIL_USERNAME / MAIL_PASSWORD  → https://app.brevo.com > SMTP & API > SMTP credentials
#   DEV_ADMIN_EMAIL                → votre email de compte de développement local
#   JWT_SECRET                     → générez avec : openssl rand -base64 48
#   DATABASE_PASSWORD              → mot de passe PostgreSQL local
# ============================================================

# Base de données locale PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/sprintreporter
DATABASE_USERNAME=sprintreporter
DATABASE_PASSWORD=sprintreporter_local

# Email (Brevo SMTP) — récupérer sur app.brevo.com > SMTP & API > SMTP credentials
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=votre-login@smtp-brevo.com
MAIL_PASSWORD=votre-token-brevo-ici
MAIL_FROM=noreply@kappa.com

# JWT — générez un secret fort pour le local (32 chars minimum)
JWT_SECRET=ThisIsADevelopmentSecretKeyThatMustBeAtLeast32CharsLong!
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# Jira (laisser mock=true pour développer sans Jira)
JIRA_MOCK_MODE=false
JIRA_BASE_URL=https://jira.amadeus.com/agile
JIRA_USER_EMAIL=votre-email-jira@company.com
JIRA_PAT=votre-personal-access-token-jira
JIRA_PROJECT_KEY=ROC
JIRA_BOARD_ID=30025

# Atlassian OAuth2 (optionnel — seulement si vous utilisez le flux OAuth)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Stripe (laisser disabled=false pour dev sans paiement)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Dev helpers
DEV_ADMIN_EMAIL=votre-email@gmail.com
